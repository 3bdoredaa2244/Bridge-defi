# ────────────────────────────────────────────────────────────────
# Bridge.defi environment configuration
# Copy this file to `.env.local` and fill in the values.
# Every variable is prefixed NEXT_PUBLIC_ because the wallet runs
# fully client-side (keys are derived inside the MeneseSDK canister).
# ────────────────────────────────────────────────────────────────

# MeneseSDK canister (production mainnet canister by default)
NEXT_PUBLIC_MENESE_CANISTER_ID=urs2a-ziaaa-aaaad-aembq-cai
NEXT_PUBLIC_IC_HOST=https://icp0.io

# Internet Identity provider used for login
NEXT_PUBLIC_II_PROVIDER=https://identity.ic0.app

# ─── MeneseSDK user-billing registration ───
# Bridge.defi's own backend canister (backend/BridgeDefiBackend.mo). After a
# user signs in with Internet Identity the frontend calls onUserLogin() here,
# and this canister calls registerUserForBilling(caller) on MeneseSDK so the
# user's principal is billed to the app's subscription instead of their own.
#
# MeneseSDK only accepts registerUserForBilling from a canister previously
# registered via registerDeveloperCanister, so a browser cannot self-register.
#
# Leave empty until the canister is deployed. While empty, registration is
# skipped and every PAID MeneseSDK endpoint traps with "Subscription required":
#   getAllAddresses, getAllBalances, getMyBitcoinAddress, getMyLitecoinAddress,
#   getMySuiAddress, getMyTonAddress, getTronAddress, getMyAptosAddress,
#   getMyNearAddress, getMyThorAddress, getMyCloakAddress, all send/sign calls.
# Verified free without a subscription:
#   getMySolanaAddress, getMyEvmAddress, getMyXrpAddress, getMyCardanoAddress,
#   health, version.
#
# This is a public canister ID, NOT a secret.
#
# To provision:
#   dfx deploy bridge_defi_backend --network ic \
#     --argument '(principal "<YOUR-DEVELOPER-IDENTITY-PRINCIPAL>")'
#   dfx canister call urs2a-ziaaa-aaaad-aembq-cai registerDeveloperCanister \
#     '(principal "<BACKEND-CANISTER-ID>", "Bridge.defi")' --network ic
NEXT_PUBLIC_BRIDGE_BACKEND_CANISTER_ID=

# ─── EVM RPC endpoints (override the public defaults with your own) ───
# Use private providers (Alchemy / Infura / QuickNode) in production for
# reliable nonce/gas reads and broadcasts.
NEXT_PUBLIC_RPC_ETHEREUM=https://eth.llamarpc.com
NEXT_PUBLIC_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
NEXT_PUBLIC_RPC_BASE=https://mainnet.base.org
NEXT_PUBLIC_RPC_POLYGON=https://polygon-rpc.com
NEXT_PUBLIC_RPC_BSC=https://bsc-dataseed.binance.org
NEXT_PUBLIC_RPC_OPTIMISM=https://mainnet.optimism.io

# ─── Non-EVM RPC endpoints ───
NEXT_PUBLIC_RPC_SOLANA=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_XRP=https://s1.ripple.com:51234
NEXT_PUBLIC_RPC_SUI=https://fullnode.mainnet.sui.io

# Optional: CoinGecko-compatible price API base (defaults to public CoinGecko)
NEXT_PUBLIC_PRICE_API_BASE=https://api.coingecko.com/api/v3
